{
    "name": "tiltak-refusjon",
    "version": "1.0.0",
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
    "engines": {
        "node": ">=26",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm",
        "pnpm": ">=12"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "clean": "find . -name 'node_modules' -prune -exec rm -rf {} + && find . -name 'dist' -not -path '*/.git/*' -prune -exec rm -rf {} +",
        "lint": "eslint --max-warnings=0",
        "lint:fix": "eslint --max-warnings=0 --fix",
        "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "prepare": "husky",
        "start:arbeidsgiver": "pnpm --filter tiltak-refusjon-arbeidsgiver dev",
        "start:saksbehandler": "pnpm --filter tiltak-refusjon-saksbehandler dev",
        "storybook:arbeidsgiver": "pnpm --filter tiltak-refusjon-arbeidsgiver storybook",
        "storybook:saksbehandler": "pnpm --filter tiltak-refusjon-saksbehandler storybook"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "eslint-plugin-storybook": "9.1.15",
        "husky": "^9.1.7",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.59.1"
    }
}
