FROM cgr.dev/chainguard/nginx:latest-dev AS prepare
USER root
COPY ./saksbehandler/storybook-static /usr/share/nginx/html
RUN touch /usr/share/nginx/html/isAlive /usr/share/nginx/html/isReady
RUN sed -i -E '/^[[:space:]]*(pid|lock_file)[[:space:]]/d' /etc/nginx/nginx.conf \
    && printf '\npid /tmp/nginx.pid;\nlock_file /tmp/nginx.lock;\n' >> /etc/nginx/nginx.conf \
    && printf '%s\n' \
        'client_body_temp_path /tmp/client_body;' \
        'proxy_temp_path /tmp/proxy;' \
        'fastcgi_temp_path /tmp/fastcgi;' \
        'uwsgi_temp_path /tmp/uwsgi;' \
        'scgi_temp_path /tmp/scgi;' \
        > /etc/nginx/conf.d/tmp-paths.conf
USER nginx
RUN nginx -t

FROM cgr.dev/chainguard/nginx:latest
COPY --from=prepare /usr/share/nginx/html /usr/share/nginx/html
COPY --from=prepare /etc/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=prepare /etc/nginx/conf.d/tmp-paths.conf /etc/nginx/conf.d/tmp-paths.conf
